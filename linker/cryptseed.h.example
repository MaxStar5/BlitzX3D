#ifndef BLITZ_CRYPT_SEED_H
#define BLITZ_CRYPT_SEED_H

#include <cstdint>

// PLACEHOLDER FOR PUBLIC RELEASES!
static const uint32_t RUNTIME_KEY_SEED = 0x00000000u;

static inline uint32_t b3dMixKey(uint32_t seed, uint32_t salt) {
    uint32_t x = seed ^ salt;
    x *= 0x9E3779B1u;
    x ^= (x >> 15);
    return x;
}

#endif